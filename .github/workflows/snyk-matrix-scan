name: Snyk Dependency Matrix Test

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  discover:
    name: Discover package.json files
    runs-on: ubuntu-latest
    outputs:
      matrix: ${{ steps.set-matrix.outputs.matrix }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - id: set-matrix
        run: |
          # Find all package.json files (excluding node_modules)
          dirs=$(find . -name "package.json" ! -path "*/node_modules/*" -exec dirname {} \;)
          echo "Found package.json files in:"
          echo "$dirs"
          
          # Convert to JSON array for matrix strategy
          json=$(printf '%s\n' "$dirs" | jq -R . | jq -s '{path: .}')
          echo "matrix=$json" >> $GITHUB_OUTPUT

  snyk:
    name: Run Snyk scan
    needs: discover
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.discover.outputs.matrix) }}

    permissions:
      contents: read
      security-events: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Set up Snyk CLI
        uses: snyk/actions/setup@v4
        env:
          SNYK_TOKEN: ${{ secrets.SNYK_TOKEN }}

      - name: Run Snyk dependency test
        env:
          SNYK_TOKEN: ${{ secrets.SNYK_TOKEN }}
        run: |
          echo "🔍 Scanning ${{ matrix.path }}"
          cd ${{ matrix.path }}
          snyk test \
            --file=package.json \
            --org=${{ secrets.SNYK_ORG_ID_NOONEBLAIN }} \
            --project-name="${{ matrix.path }}" \
            --target-reference=${{ github.ref_name }} || true
